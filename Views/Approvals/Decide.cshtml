@model CreateProof.Models.Approval

@{
ViewData["Title"] = "Record Client Decision";
}

<div class="container mt-4">
    <h2 class="mb-2">Record Client Decision</h2><p class="text-muted mb-4">
    Review approval request #@Model.Id for project #@Model.ProjectId.
</p>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Decide" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label for="decision" class="form-label">
                    Client Decision
                </label>

                <select id="decision"
                        name="decision"
                        class="form-select"
                        required>
                    <option value="">-- Select a decision --</option>
                    <option value="Approved">Approve</option>
                    <option value="Rejected">Reject</option>
                    <option value="ChangesRequested">Request Changes</option>
                </select>

                <span asp-validation-for="Decision"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="clientFeedback" class="form-label">
                    Client Feedback
                </label>

                <textarea id="clientFeedback"
                          name="clientFeedback"
                          class="form-control"
                          rows="5"
                          maxlength="2000"
                          placeholder="Enter feedback or requested changes...">@Model.ClientFeedback</textarea>

                <div class="form-text">
                    Maximum 2,000 characters.
                </div>
            </div>

            <div class="alert alert-warning">
                Once a decision is recorded, this request cannot be
                decided again through the current service logic.
            </div>

            <button type="submit" class="btn btn-primary">
                Submit Decision
            </button>

            <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-outline-secondary">
                Cancel
            </a>
        </form>
    </div>
</div>

</div>
@section Scripts {
@{
await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}