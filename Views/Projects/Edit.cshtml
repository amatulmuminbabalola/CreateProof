    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@model CreateProof.Models.Project

@{
    ViewData["Title"] = "Edit Project";
}

<style>
    .edit-page {
        min-height: 80vh;
        padding: 40px 0;
        background: #F7F5EF;
        color: #142B4A;
    }

    .edit-banner {
        padding: 30px;
        border-radius: 20px;
        color: white;
        background: linear-gradient(135deg, #142B4A, #0F8B8D);
        margin-bottom: 25px;
    }

    .edit-card {
        background: white;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 8px 28px rgba(20, 43, 74, 0.08);
    }

    .edit-page .form-label {
        color: #142B4A;
        font-weight: 650;
    }

    .edit-page .form-control,
    .edit-page .form-select {
        padding: 12px;
        border-radius: 10px;
        border: 1px solid #D8DFE5;
    }

        .edit-page .form-control:focus,
        .edit-page .form-select:focus {
            border-color: #0F8B8D;
            box-shadow: 0 0 0 0.2rem rgba(15, 139, 141, 0.15);
        }

    .edit-save {
        background: #0F8B8D;
        color: white;
        border: none;
        padding: 12px 22px;
        border-radius: 10px;
        font-weight: 650;
    }

        .edit-save:hover {
            background: #0B7072;
            color: white;
        }

    .edit-cancel {
        display: inline-block;
        background: #F0F2F5;
        color: #142B4A;
        padding: 12px 22px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
    }

    @@media (max-width: 576px) {
        .edit-page {
            padding: 22px 0;
        }

        .edit-banner,
        .edit-card {
            padding: 22px;
        }
    }
</style>

<div class="edit-page">
    <div class="container">

        <div class="edit-banner">
            <p class="mb-2">CREATEPROOF / PROJECT MANAGEMENT</p>
            <h1 class="fw-bold">Edit Project</h1>
            <p class="mb-0">
                Update the information and keep your project records accurate.
            </p>
        </div>

        <div class="edit-card">
            <form asp-controller="Projects"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-4">

                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label">
                            Project Title
                        </label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ClientName" class="form-label">
                            Client Name
                        </label>
                        <input asp-for="ClientName" class="form-control" />
                        <span asp-validation-for="ClientName"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CreativeWorkType" class="form-label">
                            Creative Work Type
                        </label>
                        <select asp-for="CreativeWorkType" class="form-select">
                            <option value="">Choose a type</option>
                            <option>Graphic Design</option>
                            <option>Photography</option>
                            <option>Videography</option>
                            <option>Video Editing</option>
                            <option>Writing</option>
                            <option>Illustration</option>
                            <option>Content Creation</option>
                            <option>Other</option>
                        </select>
                        <span asp-validation-for="CreativeWorkType"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AgreedPrice" class="form-label">
                            Agreed Price (₦)
                        </label>
                        <input asp-for="AgreedPrice"
                               type="number"
                               min="0"
                               step="0.01"
                               class="form-control" />
                        <span asp-validation-for="AgreedPrice"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Deadline" class="form-label">
                            Deadline
                        </label>
                        <input asp-for="Deadline"
                               type="date"
                               asp-format="{0:yyyy-MM-dd}"
                               class="form-control" />
                        <span asp-validation-for="Deadline"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label">
                            Project Status
                        </label>
                        <select asp-for="Status" class="form-select">
                            <option>Pending</option>
                            <option>In Progress</option>
                            <option>Awaiting Approval</option>
                            <option>Completed</option>
                        </select>
                        <span asp-validation-for="Status"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label">
                            Project Description
                        </label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"></textarea>
                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="d-flex flex-wrap gap-3 mt-4">
                    <button type="submit" class="edit-save">
                        Save Changes
                    </button>

                    <a asp-controller="Projects"
                       asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="edit-cancel">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
