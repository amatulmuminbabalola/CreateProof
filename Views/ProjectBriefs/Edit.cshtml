@model CreateProof.ViewModels.ProjectBriefs.EditProjectBriefViewModel

@{
ViewData["Title"] = "Edit Project Brief";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-primary text-white p-4">
                <h2 class="mb-1">Edit Project Brief</h2>
                <p class="mb-0">
                    Update the project scope, deliverables, deadline, and agreed terms.
                </p>
            </div>

            <div class="card-body p-4 p-md-5">

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert"></div>

                    <input asp-for="Id" type="hidden" />

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">
                            Project Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Describe the project's goals and requirements..."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Deliverables" class="form-label fw-semibold">
                            Deliverables
                        </label>

                        <textarea asp-for="Deliverables"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Describe the expected deliverables..."></textarea>

                        <span asp-validation-for="Deliverables"
                              class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="Deadline" class="form-label fw-semibold">
                                Deadline
                            </label>

                            <input asp-for="Deadline"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="Deadline"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-4">
                            <label asp-for="AgreedPrice" class="form-label fw-semibold">
                                Agreed Price (₦)
                            </label>

                            <input asp-for="AgreedPrice"
                                   type="number"
                                   min="0.01"
                                   step="0.01"
                                   class="form-control" />

                            <span asp-validation-for="AgreedPrice"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="IncludedRevisions"
                                   class="form-label fw-semibold">
                                Included Revisions
                            </label>

                            <input asp-for="IncludedRevisions"
                                   type="number"
                                   min="0"
                                   max="100"
                                   class="form-control" />

                            <span asp-validation-for="IncludedRevisions"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-4">
                            <label asp-for="PaymentTerms"
                                   class="form-label fw-semibold">
                                Payment Terms
                            </label>

                            <input asp-for="PaymentTerms"
                                   class="form-control"
                                   placeholder="e.g. 50% upfront, 50% on completion" />

                            <span asp-validation-for="PaymentTerms"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <button type="submit" class="btn btn-primary px-4">
                            Save Changes
                        </button>

                        <a asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary px-4">
                            Cancel
                        </a>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

</div>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
}