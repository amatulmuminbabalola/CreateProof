@model CreateProof.ViewModels.ProjectBriefs.ProjectBriefDetailsViewModel

@{
ViewData["Title"] = "Project Brief Details";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h2 class="fw-bold mb-1">Project Brief</h2>
                <p class="text-muted mb-0">Review the project scope and agreed terms.</p>
            </div>

            @{
                var statusClass = Model.ConfirmationStatus switch
                {
                    "Confirmed" => "bg-success",
                    "ChangesRequested" => "bg-warning text-dark",
                    _ => "bg-secondary"
                };
            }

            <span class="badge @statusClass fs-6">
                @Model.ConfirmationStatus.Replace("ChangesRequested", "Changes Requested")
            </span>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4 p-md-5">

                <div class="mb-4">
                    <h5 class="fw-bold">Project Description</h5>
                    <p class="text-muted" style="white-space: pre-line;">@Model.Description</p>
                </div>

                <hr />

                <div class="mb-4">
                    <h5 class="fw-bold">Deliverables</h5>
                    <p class="text-muted" style="white-space: pre-line;">@Model.Deliverables</p>
                </div>

                <hr />

                <div class="row g-4 my-2">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <small class="text-muted d-block mb-1">Deadline</small>
                            <h5 class="fw-bold mb-0">
                                @Model.Deadline.ToString("dd MMMM yyyy")
                            </h5>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <small class="text-muted d-block mb-1">Agreed Price</small>
                            <h5 class="fw-bold text-success mb-0">
                                ₦@Model.AgreedPrice.ToString("N2")
                            </h5>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <small class="text-muted d-block mb-1">Included Revisions</small>
                            <h5 class="fw-bold mb-0">@Model.IncludedRevisions</h5>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <small class="text-muted d-block mb-1">Project ID</small>
                            <h5 class="fw-bold mb-0">#@Model.ProjectId</h5>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="mb-4">
                    <h5 class="fw-bold">Payment Terms</h5>
                    <p class="text-muted" style="white-space: pre-line;">@Model.PaymentTerms</p>
                </div>

                <hr />

                <div class="row g-3 text-muted small">
                    <div class="col-md-4">
                        <strong class="d-block text-dark">Created</strong>
                        @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                    </div>

                    <div class="col-md-4">
                        <strong class="d-block text-dark">Last Updated</strong>
                        @(Model.UpdatedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "Not updated")
                    </div>

                    <div class="col-md-4">
                        <strong class="d-block text-dark">Confirmation Date</strong>
                        @(Model.ConfirmedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "Not confirmed")
                    </div>
                </div>

            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            @if (Model.ConfirmationStatus != "Confirmed")
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-primary px-4">
                    Edit Brief
                </a>

                <a asp-action="Confirm"
                   asp-route-id="@Model.Id"
                   class="btn btn-success px-4">
                    Review & Respond
                </a>
            }

            <a asp-controller="Projects"
               asp-action="Details"
               asp-route-id="@Model.ProjectId"
               class="btn btn-outline-secondary px-4">
                Back to Project
            </a>
        </div>

    </div>
</div>

</div>