@model CreateProof.ViewModels.Notifications.NotificationListViewModel

@{
    ViewData["Title"] = "Notifications";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Notifications</h2>
            <p class="text-muted mb-0">Stay updated on your project activities.</p>
        </div>

        @if (Model.UnreadCount > 0)
        {
            <form asp-controller="Notifications"
                  asp-action="MarkAllAsRead"
                  method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-check2-all me-1"></i>
                    Mark all as read
                </button>
            </form>
        }
    </div>

    <div class="notification-summary mb-4">
        <div class="summary-card">
            <span class="summary-label">Total Notifications</span>
            <span class="summary-value">@Model.TotalCount</span>
        </div>

        <div class="summary-card">
            <span class="summary-label">Unread Notifications</span>
            <span class="summary-value">@Model.UnreadCount</span>
        </div>
    </div>

    @if (!Model.HasNotifications)
    {
        <div class="empty-notifications text-center py-5">
            <div class="empty-icon mb-3">
                <i class="bi bi-bell"></i>
            </div>
            <h4>No notifications yet</h4>
            <p class="text-muted mb-0">
                When something important happens to your projects,
                you'll see it here.
            </p>
        </div>
    }
    else
    {
        <div class="notification-list">
            @foreach (var notification in Model.Notifications)
            {
                <div class="notification-card @(notification.IsRead ? "read" : "unread")">
                    <div class="notification-icon">
                        <i class="@GetNotificationIcon(notification.Type)"></i>
                    </div>

                    <div class="notification-content">
                        <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                            <h5 class="notification-title mb-1">
                                @notification.Title

                                @if (!notification.IsRead)
                                {
                                    <span class="unread-dot" title="Unread"></span>
                                }
                            </h5>

                            <small class="notification-time">
                                @notification.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                            </small>
                        </div>

                        <p class="notification-message mb-2">
                            @notification.Message
                        </p>

                        @if (!string.IsNullOrWhiteSpace(notification.ProjectTitle))
                        {
                            <p class="project-reference mb-3">
                                <i class="bi bi-folder2-open me-1"></i>
                                @notification.ProjectTitle
                            </p>
                        }

                        <div class="notification-actions">
                            @if (notification.ProjectId.HasValue)
                            {
                                <a asp-controller="Project"
                                   asp-action="Details"
                                   asp-route-id="@notification.ProjectId"
                                   class="btn btn-sm btn-view-project">
                                    View Project
                                </a>
                            }

                            @if (!notification.IsRead)
                            {
                                <form asp-controller="Notifications"
                                      asp-action="MarkAsRead"
                                      asp-route-id="@notification.Id"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-mark-read">
                                        Mark as read
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="read-label">
                                    <i class="bi bi-check2-all me-1"></i>
                                    Read
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@functions {
    private string GetNotificationIcon(string? type)
    {
        return type?.ToLowerInvariant() switch
        {
            "revision" or "revisionrequest" => "bi bi-pencil-square",
            "approval" or "approved" => "bi bi-check-circle",
            "rejection" or "rejected" => "bi bi-x-circle",
            "deadline" => "bi bi-calendar-event",
            "statuschange" => "bi bi-arrow-repeat",
            "pendingapproval" => "bi bi-hourglass-split",
            _ => "bi bi-bell"
        };
    }
}